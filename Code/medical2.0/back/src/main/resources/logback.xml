<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    <!-- màu sắcNgàynhật ký -->
    <!-- màu sắcNgàynhật ký依dựa vào của 渲染Lớp -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>
    <!-- màu sắcNgàynhật kýđịnh dạng -->
    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <contextName>geeke</contextName>

    <!--định nghĩaNgàynhật kýTệp của lưu trữĐịa chỉ -->
    <property name="LOG_HOME" value="logs"/>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <!--nàyNgàynhật kýappender có  là mởphátsử dụng, Chỉ cấu hình mức thấp nhất, Mức nhật ký xuất ra console là thông tin nhật ký lớn hơn hoặc bằng mức này-->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <!--encoder Mặc địnhcấu hình là PatternLayoutEncoder-->
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="RollingFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <!-- có thểđểmỗi ngàysảnsinhmộtCáiNgàynhật kýTệp, Tối đa 180 Cái, tự độngtrả lại滚 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/%d{yyyy-MM,aux}/geeke-%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <!-- keep 180 days' worth of history capped at 50GB total size -->
            <maxHistory>180</maxHistory>
            <totalSizeCap>40GB</totalSizeCap>
        </rollingPolicy>
        <!-- Định dạng tệp nhật ký -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%file:%line][%thread] - %msg%n</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="AsyncRollingFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="RollingFile"/>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- XuấtĐếnkiểm soátmáy và Tệp, có thểđịnh nghĩahơnnhiều của  Appender -->
    <root level="INFO">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncRollingFile"/>
    </root>

    <!-- Dưới đây cấu hình mức lọc nhật ký cho một số package bên thứ ba, dùng đểTránh刷屏 -->
<!--     <logger name="org.mybatis" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache" level="WARN"/> -->
    <!--NếuCầnin ấnSQL,Có thểĐưadướimặt của cấploạiĐặt là DEBUG -->
    <logger name="com.geeke.example.dao" level="DEBUG"/>

    <!-- Thông tin hàng đợi tin nhắn nhật ký thao tác được ghi riêng vào một tệp -->
    <appender name="actionLogMQAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/%d{yyyy-MM,aux}/mq-actionlog-%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <!-- keep 180 days' worth of history capped at 50GB total size -->
            <maxHistory>180</maxHistory>
        </rollingPolicy>
        <!-- Định dạng tệp nhật ký -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%file:%line][%thread] - %msg%n</pattern>
            <charset>utf-8</charset>
        </encoder>
        <append>true</append>
        <prudent>false</prudent>
    </appender>
    <logger name="com.geeke.config.rabbitmq" level="INFO" additivity="false">
        <appender-ref ref="actionLogMQAppender"/>
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncRollingFile"/>
    </logger>

</configuration>
