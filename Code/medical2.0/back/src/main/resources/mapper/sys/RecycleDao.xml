<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geeke.sys.dao.RecycleDao">
     
     <!-- Viết thủ công -->
     
    <update id="updateActionStaus">
        <!-- DS45: claim co dieu kien — chi nhan action chua duoc khoi
             phuc (status='0'). Neu khong, restore lan 2 tren action
             da khoi phuc van tra rows 1 va ghi them dong audit
             RESTORED trung (probe ds45 pre: restored_rows 1 -> 2). -->
        UPDATE sys_action SET status = '1' WHERE id = #{id} AND status = '0'
    </update>
    
    
    <update id="restore">
        UPDATE ${tableName} SET del_flag = '0' WHERE id = #{id}
    </update>
    
</mapper>