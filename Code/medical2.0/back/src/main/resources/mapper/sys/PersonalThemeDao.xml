<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geeke.sys.dao.PersonalThemeDao">
    
    <sql id="personalThemeColumns">
        a.id AS "id",
        a.user_id AS "userId",
        a.theme AS "theme",
        a.remarks AS "remarks",
        a.create_by AS "createBy",
        a.create_date AS "createDate",
        a.update_by AS "updateBy",
        a.update_date AS "updateDate",
        a.del_flag AS "delFlag"
    </sql>
    
    <sql id="personalThemeJoins">
    </sql>
    
    <select id="get" resultType="com.geeke.sys.entity.PersonalTheme">
        SELECT 
            <include refid="personalThemeColumns"/>
        FROM sys_personal_theme a
        <include refid="personalThemeJoins"/>
        WHERE a.id = #{id}
    </select>
    
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM sys_personal_theme a
        <include refid="personalThemeJoins"/>
        <where>
            1=1
            AND a.id > 0
            AND a.del_flag = #{DEL_FLAG_NORMAL}
            <include refid="Common.whereParams"/>
        </where>
    </select>    
    
    <select id="listPage" resultType="com.geeke.sys.entity.PersonalTheme">
        SELECT 
            <include refid="personalThemeColumns"/>
        FROM sys_personal_theme a
        <include refid="personalThemeJoins"/>
        <where>
            1=1
            AND a.id > 0
            AND a.del_flag = #{DEL_FLAG_NORMAL}
            <include refid="Common.whereParams"/>
        </where>
        <choose>
            <when test="order != null and order != ''">
                ORDER BY ${order}
            </when>            
            <otherwise>
                ORDER BY a.update_date DESC
            </otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>
    
    <select id="listAll" resultType="com.geeke.sys.entity.PersonalTheme">
        SELECT 
            <include refid="personalThemeColumns"/>
        FROM sys_personal_theme a
        <include refid="personalThemeJoins"/>
        <where>
            1=1
            AND a.id > 0
            AND a.del_flag = #{DEL_FLAG_NORMAL}
            <include refid="Common.whereParams"/>
        </where>
        <choose>
            <when test="order != null and order != ''">
                ORDER BY ${order}
            </when> 
            <otherwise>
                ORDER BY a.update_date DESC
            </otherwise>
        </choose>
    </select>
      
    <insert id="insert">
        INSERT INTO sys_personal_theme(
            id,
            user_id,
            theme,
            remarks,
            create_by,
            create_date,
            update_by,
            update_date,
            del_flag
        ) VALUES (
            #{id},
            #{userId},
            #{theme},
            #{remarks},
            #{createBy},
            #{createDate},
            #{updateBy},
            #{updateDate},
            #{delFlag}
        )
    </insert>
    
    <update id="update">
        UPDATE sys_personal_theme SET     
            user_id = #{userId},
            theme = #{theme},
            update_by = #{updateBy},
            update_date = #{updateDate}
        WHERE id = #{id}
    </update>
    
    <delete id="delete">
        DELETE FROM sys_personal_theme WHERE id = #{id}
    </delete>

    <!-- DS48: bulk statements were missing (same wart DS40 fixed for the
         outbound slips): CrudService.bulk* calls dao.bulk* directly, so
         every bulk call 500'd "Invalid bound statement" for any session.
         bulkInsert/bulkUpdate mirror the single-row columns above;
         bulkDelete is a physical delete like the single delete
         (this table has no soft-delete use). Guards live in
         PersonalThemeController (payload userId for insert/update +
         stored-row check for update/delete). -->
    <insert id="bulkInsert" parameterType="java.util.List">
        INSERT INTO sys_personal_theme(
            id,
            user_id,
            theme,
            remarks,
            create_by,
            create_date,
            update_by,
            update_date,
            del_flag
        ) VALUES
        <foreach collection="entitys" index="index" item="entity" open="" separator="," close="">
        (
            #{entity.id},
            #{entity.userId},
            #{entity.theme},
            #{entity.remarks},
            #{entity.createBy},
            #{entity.createDate},
            #{entity.updateBy},
            #{entity.updateDate},
            #{entity.delFlag}
        )
        </foreach>
    </insert>

    <update id="bulkUpdate" parameterType="java.util.List">
        UPDATE sys_personal_theme
        <set>
            <trim prefix="user_id=case" suffix="end,">
                <foreach collection="entitys" item="entity" index="index">
                    when id=#{entity.id} then #{entity.userId}
                </foreach>
            </trim>
            <trim prefix="theme=case" suffix="end,">
                <foreach collection="entitys" item="entity" index="index">
                    when id=#{entity.id} then #{entity.theme}
                </foreach>
            </trim>
            <trim prefix="update_by=case" suffix="end,">
                <foreach collection="entitys" item="entity" index="index">
                    when id=#{entity.id} then #{entity.updateBy}
                </foreach>
            </trim>
            <trim prefix="update_date=case" suffix="end,">
                <foreach collection="entitys" item="entity" index="index">
                    when id=#{entity.id} then #{entity.updateDate}
                </foreach>
            </trim>
        </set>
        WHERE id IN
        <foreach collection="entitys" item="entity" index="index" separator="," open="(" close=")">
            #{entity.id}
        </foreach>
    </update>

    <delete id="bulkDelete" parameterType="java.util.List">
        DELETE FROM sys_personal_theme WHERE id IN
        <foreach collection="entitys" item="entity" index="index" separator="," open="(" close=")">
            #{entity.id}
        </foreach>
    </delete>

</mapper>